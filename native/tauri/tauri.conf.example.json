{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Desk Meter",
  "version": "0.8.0",
  "identifier": "com.tizwildin.ai-desk-meter",
  "build": {
    "beforeDevCommand": "cd ../../host && ai-meter serve --host 127.0.0.1 --port 8787",
    "devUrl": "http://127.0.0.1:8787",
    "frontendDist": "../../docs"
  },
  "app": {
    "windows": [
      {
        "title": "AI Desk Meter",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8787; connect-src 'self' http://127.0.0.1:8787; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
