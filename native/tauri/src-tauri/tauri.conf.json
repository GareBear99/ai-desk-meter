{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Desk Meter",
  "version": "1.2.1",
  "identifier": "com.tizwildinentertainment.aideskmeter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Desk Meter",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
